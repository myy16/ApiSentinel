{
  "name": "apisentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Developer Security & Integration Platform (Go-Centric)",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && go run ./cmd/server/main.go",
    "dev:frontend": "npm run dev --workspace=apisentinel-frontend",
    "dev": "npm run dev:backend",
    "build:backend": "cd backend && go build -ldflags=\"-s -w\" -o bin/server.exe ./cmd/server",
    "build:agent": "cd agent && go build -ldflags=\"-s -w\" -o bin/apisentinel.exe ./cmd/apisentinel",
    "build:frontend": "npm run build --workspace=apisentinel-frontend",
    "build": "npm run build:backend && npm run build:agent && npm run build:frontend",
    "test:backend": "cd backend && go test -v ./...",
    "test:frontend": "npm run test --workspace=apisentinel-frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "sqlc": "cd backend && sqlc generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "security",
    "api",
    "webhook",
    "replay",
    "mock",
    "scanner",
    "developer-tools",
    "golang"
  ],
  "author": "ApiSentinel Team",
  "license": "MIT"
}
