# Copy this file to .env.production. Never commit the copied file.
POSTGRES_USER=apisentinel
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_DB=apisentinel_db

JWT_SECRET=replace_with_a_long_random_jwt_secret
WEBHOOK_SECRET_ENCRYPTION_KEY=replace_with_a_separate_long_random_encryption_key
CORS_ORIGIN=https://app.example.com

# Public URLs are baked into the frontend image during docker compose build.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

# Backend gRPC must receive certificate paths accessible inside the container.
TLS_CERT_FILE=/run/secrets/grpc.crt
TLS_KEY_FILE=/run/secrets/grpc.key
TLS_CERT_PATH=/absolute/path/to/grpc.crt
TLS_KEY_PATH=/absolute/path/to/grpc.key

BACKEND_PORT=3001
FRONTEND_PORT=3000
GRPC_PORT=50051
