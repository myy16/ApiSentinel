# Environment (used by Go backend; values: development | production)
APP_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://apisentinel:apisentinel_secret@localhost:5432/apisentinel_db
POSTGRES_USER=apisentinel
POSTGRES_PASSWORD=apisentinel_secret
POSTGRES_DB=apisentinel_db
POSTGRES_PORT=5432

# Cache & Queue (Valkey / Redis)
VALKEY_URL=localhost:6379
VALKEY_PORT=6379

# Authentication (JWT)
# Use a unique, securely generated value of at least 32 characters in every environment.
# REQUIRED in production — server will not start without it.
JWT_SECRET=replace_with_a_unique_32_character_minimum_secret
JWT_ACCESS_TTL=24h

# CORS (comma-separated origins; REQUIRED in production, wildcard not allowed)
# Example production value: https://app.apisentinel.dev,https://dashboard.apisentinel.dev
CORS_ORIGIN=*

# gRPC Agent Authentication
# Set a strong secret for agent-to-cloud communication
# AGENT_SECRET_KEY=replace_with_a_secure_agent_key

# gRPC TLS (recommended for production)
# TLS_CERT_FILE=/path/to/server.crt
# TLS_KEY_FILE=/path/to/server.key

# Development only — allows insecure gRPC without auth (NEVER set in production)
# ALLOW_INSECURE_GRPC=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
