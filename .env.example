# Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://apisentinel:apisentinel_secret@localhost:5432/apisentinel_db
POSTGRES_USER=apisentinel
POSTGRES_PASSWORD=apisentinel_secret
POSTGRES_DB=apisentinel_db
POSTGRES_PORT=5432

# Cache & Queue (Valkey / Redis)
VALKEY_URL=redis://localhost:6379
VALKEY_PORT=6379

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
